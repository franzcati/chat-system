# STUN funciona para redes simples. Para producción configure TURN para garantizar conectividad detrás de NAT/VPN/firewalls.
# Puede indicar varios TURN separados por coma.
VITE_TURN_URL=turn:turn.sudominio.com:3478?transport=udp,turn:turn.sudominio.com:3478?transport=tcp
VITE_TURN_USERNAME=quickchat
VITE_TURN_CREDENTIAL=cambie-esta-clave
